# Copia a .env.local para desarrollo y configúralas como variables de entorno en producción.

# Postgres: pooler para la app (Supabase: puerto 6543)
DATABASE_URL=postgresql://...

# Postgres: conexión directa para `prisma db push` (Supabase: puerto 5432)
DIRECT_URL=postgresql://...

# 32 bytes en base64. Si la cambias, las contraseñas ya guardadas dejan de descifrarse.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTEKEEPER_SECRET_KEY=

# Opcional en producción:
# HOST=0.0.0.0            # necesario en Render; por defecto 127.0.0.1
# ALLOWED_HOSTS=          # dominios públicos extra, separados por comas (Render añade el .onrender.com solo)
