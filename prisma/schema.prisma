generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["notekeeper"]
}

/// One row per Supabase account that can use Notekeeper (the id is auth.users.id).
/// session_limit_minutes / session_cooldown_hours cap how long a session lasts and
/// how long the account waits before signing in again (see `npm run session-limit`).
model users {
  id                     String    @id @db.Uuid
  username               String    @unique
  email                  String    @unique
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  auth_version           Int       @default(0) @db.SmallInt
  session_limit_minutes  Int?
  session_cooldown_hours Int?
  last_sign_in_at        DateTime? @db.Timestamptz(6)
  /// Supabase session id of the last sign-in through Notekeeper. Time-limited
  /// accounts only accept this session, so one requested straight from Supabase
  /// with the public key is rejected.
  session_id             String?   @db.Uuid
  notes                  notes[]
  labels                 labels[]

  @@schema("notekeeper")
}

model notes {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String        @db.Uuid
  title       String        @default("")
  blocks      Json          @default("[]")
  color       String        @default("default")
  pinned      Boolean       @default(false)
  archived    Boolean       @default(false)
  trashed     Boolean       @default(false)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  user        users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  note_labels note_labels[]

  @@index([user_id, trashed, archived])
  @@schema("notekeeper")
}

model labels {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String        @db.Uuid
  name        String
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  user        users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  note_labels note_labels[]

  @@unique([user_id, name])
  @@schema("notekeeper")
}

model note_labels {
  note_id  String @db.Uuid
  label_id String @db.Uuid
  position Int    @default(0)
  note     notes  @relation(fields: [note_id], references: [id], onDelete: Cascade)
  label    labels @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([note_id, label_id])
  @@index([label_id])
  @@schema("notekeeper")
}
